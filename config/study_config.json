{
  "study_name": "ConformityGate",
  "pollutant": "PM2.5",
  "raw_data": {
    "quant_sensors": "data/raw/quant/QUANT_SensorSystems_hourly.csv",
    "quant_reference": "data/raw/quant/QUANT_Reference_hourly.csv",
    "quant_duplicate_reference": "data/raw/quant/QUANT_DuplicateRef_hourly.csv",
    "india_workbook": "data/raw/india/Campmier_Manuscript_Data.xlsx"
  },
  "derived_data": {
    "quant_hourly": "data/processed/quant_purpleair_hourly.csv.gz",
    "india_hourly": "data/processed/india_purpleair_hourly.csv.gz",
    "daily": "data/processed/purpleair_daily.csv.gz",
    "audit": "results/data_audit.json"
  },
  "quality_control": {
    "valid_hours_per_day": 18,
    "deployment_days": 30,
    "valid_days_per_deployment": 23,
    "audit_lookback_calendar_days": 14,
    "exclude_quant_flags": ["Error"]
  },
  "conformity_targets": {
    "slope_min": 0.65,
    "slope_max": 1.35,
    "intercept_min_ug_m3": -5.0,
    "intercept_max_ug_m3": 5.0,
    "r2_min": 0.70,
    "rmse_max_ug_m3": 7.0,
    "nrmse_max_percent": 30.0,
    "error_rule": "rmse_or_nrmse"
  },
  "target_reference_budgets_days": [0, 1, 3, 7],
  "gate_decision": {
    "false_acceptance_target": 0.05,
    "false_rejection_target": 0.10,
    "minimum_release_coverage": 0.20,
    "minimum_release_blocks": 30,
    "confidence_level": 0.95,
    "cluster_bootstrap_replicates": 2000
  },
  "window_protocols": {
    "primary_stride_days": 30,
    "sensitivity_stride_days": 7
  },
  "random_seed": 20260805
}
